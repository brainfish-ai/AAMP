# =============================================================================
# AAMP Deployment Secrets — copy to .env.deploy and fill in your values
# NEVER commit .env.deploy to git (it is in .gitignore)
#
# Usage:
#   cp .env.deploy.example .env.deploy
#   # Edit .env.deploy with your actual values
#   source .env.deploy
#   bash scripts/deploy.sh
# =============================================================================

# ── Synadia Cloud (NATS) ──────────────────────────────────────────────────────
# Sign up free (no credit card) at https://cloud.synadia.com/register
#
# Finding your credentials in the Synadia dashboard:
#   Option A — Access Token (Personal/free plan)
#     1. Go to your Account → Users → select or create a User
#     2. Click "Generate Credentials" or "Access Token"
#     3. Copy the token string and paste it as NATS_CREDS below
#
#   Option B — .creds file (paid plans)
#     1. Go to your Account → Users → Download Credentials
#     2. Paste the full file contents below (starts with "-----BEGIN NATS USER JWT-----")
#
# The relay auto-detects which format you're using.

NATS_URL=wss://connect.ngs.global

# Paste either your access token (free tier) OR .creds file contents here:
NATS_CREDS=PASTE_YOUR_ACCESS_TOKEN_OR_CREDS_FILE_HERE

# ── Vercel team scope ────────────────────────────────────────────────────────
# Run `vercel teams ls` to see your team IDs.
# Defaults to "brainfish" if not set.
VERCEL_SCOPE=brainfish

# ── GitHub (repo URL for Vercel Sandbox to clone) ─────────────────────────────
# The repo must be public, OR you can pass git credentials in the URL:
#   https://oauth2:YOUR_PAT@github.com/your-org/aamp
REPO_URL=https://github.com/brainfish-ai/AAMP

# ── Optional: Vercel Sandbox snapshot IDs ────────────────────────────────────
# After the first demo run, snapshot IDs are printed in the UI logs.
# Add them here to skip the slow pnpm install + build on subsequent runs.
# VERCEL_SNAPSHOT_FINANCE=snap_xxxxxxxxxxxxxxxx
# VERCEL_SNAPSHOT_RESEARCH=snap_xxxxxxxxxxxxxxxx
# VERCEL_SNAPSHOT_COMPLIANCE=snap_xxxxxxxxxxxxxxxx

# ── Set automatically by deploy.sh ───────────────────────────────────────────
# These are written back by the script after Cloudflare deployment.
# You can also set them manually if you already have deployed relays.
# RELAY_A_URL=https://aamp-relay-a.YOUR_SUBDOMAIN.workers.dev
# RELAY_B_URL=https://aamp-relay-b.YOUR_SUBDOMAIN.workers.dev
