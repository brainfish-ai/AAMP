{
  "name": "@aamp/relay",
  "version": "0.1.0",
  "description": "AAMP Relay Server — Cloudflare Worker, NATS JetStream + HTTP federation gateway",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:relay-b": "wrangler deploy --env relay-b",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aamp/core": "workspace:*",
    "@aamp/identity": "workspace:*",
    "hono": "^4.6.0",
    "nats.ws": "^1.29.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.7",
    "@cloudflare/workers-types": "^4.20241218.0",
    "wrangler": "^3.101.0"
  }
}
